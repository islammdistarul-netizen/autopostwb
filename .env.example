# Copy to .env and `set -a; source .env; set +a` before running the pipeline (or use systemd EnvironmentFile).

# Postiz -> Settings -> Public API
POSTIZ_API_KEY=

# Script provider: claude (headless `claude -p`) | template (deterministic, no LLM — smoke tests)
CF_SCRIPT_PROVIDER=claude
# Optional model override for `claude -p --model`
CF_CLAUDE_MODEL=

# Handle printed in carousel footers, e.g. @your.brand
CF_BRAND_HANDLE=

# Optional: Pexels API key for scripts/fetch-broll.sh
PEXELS_API_KEY=

# Logging: CF_DEBUG=1 for verbose, CF_QUIET=1 for errors only (cron)
CF_DEBUG=0

# --- Voice providers (pick via config/app.config.json -> voice.defaultPreset) ---
# Yandex SpeechKit: service account API key (role ai.speechkit-tts.user) + folder id
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
# ElevenLabs
ELEVENLABS_API_KEY=

# --- Sprite generation (scripts/generate-sprite.ts; never runs inside the render loop) ---
# CF_SPRITE_BACKEND=openai | gemini
CF_SPRITE_BACKEND=openai
OPENAI_API_KEY=
GEMINI_API_KEY=

# Cap per `claude -p` scripting call (USD)
CF_CLAUDE_MAX_BUDGET_USD=0.50
