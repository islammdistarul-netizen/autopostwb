# Copy to .env and `set -a; source .env; set +a` before running the pipeline (or use systemd EnvironmentFile).

# Postiz -> Settings -> Public API
POSTIZ_API_KEY=

# Script provider: claude (headless `claude -p`) | template (deterministic, no LLM — smoke tests)
CF_SCRIPT_PROVIDER=claude
# Optional model override for `claude -p --model`
CF_CLAUDE_MODEL=

# Handle printed in carousel footers, e.g. @your.brand
CF_BRAND_HANDLE=

# Optional: Pexels API key for scripts/fetch-broll.sh
PEXELS_API_KEY=

# Logging: CF_DEBUG=1 for verbose, CF_QUIET=1 for errors only (cron)
CF_DEBUG=0
