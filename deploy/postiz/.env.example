# docker compose --env-file deploy/postiz/.env ...
POSTIZ_DOMAIN=postiz.example.com
# Pin a release (ghcr.io/gitroomhq/postiz-app tags, e.g. v2.23.0). Temporal-era
# releases also need `--profile temporal` when starting compose.
POSTIZ_IMAGE_TAG=latest
# Outbound proxy for the postiz container only (Meta/TikTok from RU IPs), e.g. http://user:pass@host:port
POSTIZ_HTTPS_PROXY=
POSTIZ_JWT_SECRET=change-me-64-random-chars
POSTIZ_DB_PASSWORD=change-me
POSTIZ_DISABLE_REGISTRATION=false   # set true after creating the owner account

# Provider apps — only for channels you actually connect
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
TELEGRAM_BOT_NAME=
TELEGRAM_TOKEN=
VK_CLIENT_ID=
VK_CLIENT_SECRET=
